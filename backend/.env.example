ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3001

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://clairvoyance:clairvoyance_dev@localhost:5433/clairvoyance

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# OAuth (optional — leave blank to disable social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts saved database passwords (64 hex chars: `openssl rand -hex 32`)
CREDENTIAL_ENCRYPTION_KEY=

# Optional: Voyage AI embeddings — semantic table search for large databases + session search
VOYAGE_API_KEY=

# Optional tuning (defaults shown)
# CLAIRVOYANCE_MODEL=claude-sonnet-5-5   # claude-opus-5-5 for very large or messy databases
# ANTHROPIC_REFUSAL_FALLBACK=on        # set to "off" if your gateway rejects the fallbacks parameter
# MAX_ROWS=10000                       # rows a query may return
# MAX_CLIENT_ROWS=1000                 # rows sent to the browser / stored per answer
# DATA_ROWS_TO_MODEL=40                # preview rows the AI sees (it also gets full-column statistics)
# QUERY_TIMEOUT_MS=30000               # per-statement timeout on live databases
# SCHEMA_CACHE_TTL_MS=600000           # how long a live database's table list is cached
# FULL_SCHEMA_TABLE_LIMIT=25           # above this many tables, only relevant tables go in the prompt

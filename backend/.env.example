ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=3001
MAX_ROWS=10000

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://clairvoyance:clairvoyance_dev@localhost:5433/clairvoyance

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGIN=http://localhost:3000

# OAuth (optional — leave blank to disable social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 3: credential encryption key (32-byte hex)
CREDENTIAL_ENCRYPTION_KEY=

# Phase 4: Voyage AI embeddings
VOYAGE_API_KEY=
